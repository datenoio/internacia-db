{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Intblocks YAML schema (core subset)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "blocktype", "status"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "blocktype": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "status": {
      "type": "string",
      "enum": ["formal", "informal", "de-facto", "historical"]
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["url", "type"],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "type": {
            "type": "string",
            "enum": ["website", "wikipedia", "wikidata"]
          }
        },
        "additionalProperties": true
      }
    },
    "includes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "type", "status"],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": ["country", "organization", "territory", "historical-country"]
          },
          "status": {
            "type": "string",
            "enum": [
              "member",
              "observer",
              "associated",
              "associated_observer",
              "associate",
              "associate_member",
              "founding_member",
              "former_member",
              "participant",
              "recipient",
              "contributor",
              "represented",
              "funder",
              "cooperating",
              "partner",
              "validation",
              "extension"
            ]
          },
          "joined": {
            "type": ["string", "null"],
            "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
          },
          "left": {
            "type": ["string", "null"],
            "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
          }
        },
        "additionalProperties": true
      }
    },
    "founded": {
      "type": "string",
      "pattern": "^(\\d{4}s|\\d{4}(-\\d{2}(-\\d{2})?)?)$",
      "description": "Foundation date (YYYY, YYYY-MM, YYYY-MM-DD) or decade (e.g. 1950s) when only decade precision is known"
    },
    "dissolved": {
      "type": "string",
      "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
    },
    "active_period": {
      "type": "object",
      "required": ["start"],
      "properties": {
        "start": {
          "type": "string",
          "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
        },
        "end": {
          "type": ["string", "null"],
          "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
        }
      },
      "additionalProperties": true
    },
    "headquarters": {
      "type": "object",
      "properties": {
        "city": {
          "type": "string"
        },
        "country": {
          "type": "string",
          "minLength": 2,
          "maxLength": 2
        },
        "coordinates": {
          "type": "object",
          "properties": {
            "lat": {
              "type": "number"
            },
            "lng": {
              "type": "number"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "geographic_scope": {
      "type": "string",
      "enum": ["global", "regional", "sub-regional", "bilateral"]
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "partof": {
      "oneOf": [
        {
          "type": "object",
          "required": ["id"],
          "properties": {
            "id": { "type": "string" },
            "name": { "type": "string" }
          },
          "additionalProperties": true
        },
        {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": ["id"],
                "properties": {
                  "id": { "type": "string" },
                  "name": { "type": "string" }
                },
                "additionalProperties": true
              },
              {
                "type": "string"
              }
            ]
          }
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "suborganizations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "acronyms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["lang", "value"],
        "properties": {
          "lang": { "type": "string" },
          "value": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "wikidata_id": {
      "type": "string",
      "pattern": "^Q[1-9][0-9]*$"
    },
    "membership_count": {
      "type": "integer",
      "minimum": 0
    },
    "membership_applicability": {
      "type": "string",
      "enum": ["not_applicable"],
      "description": "When not_applicable, an empty includes list is intentional (conceptual entities, acronyms, etc.)"
    },
    "founding_members": {
      "type": "array",
      "items": { "type": "string" }
    },
    "last_verified": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "description": {
      "type": "string",
      "description": "Short text summarizing what the entity is for"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of keywords for the entity"
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "name"],
        "properties": {
          "key": {
            "type": "string",
            "description": "Topic identifier (e.g., 'culture', 'climate', 'economy')"
          },
          "name": {
            "type": "string",
            "description": "Human-readable topic name"
          }
        },
        "additionalProperties": true
      },
      "description": "List of topics with which this entity is associated"
    },
    "other_names": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "description": "Language code (e.g., 'ar', 'zh', 'en', 'fr', 'ru', 'es')" },
          "name": { "type": "string", "description": "Name in the specified language" }
        },
        "additionalProperties": true
      },
      "description": "Names in multiple languages (UN official languages)"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes or historical information about the entity"
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "source", "retrieved_at"],
        "properties": {
          "field": { "type": "string" },
          "source": { "type": "string" },
          "url": { "type": "string" },
          "retrieved_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "license": { "type": "string" }
        },
        "additionalProperties": true
      },
      "description": "Field-level sourcing for enriched fields"
    },
    "legal_status": {
      "type": "string",
      "description": "Legal character of the entity (e.g. intergovernmental, treaty, non-binding)"
    },
    "recognition_status": {
      "type": "string",
      "description": "How the entity is recognized within a broader system (e.g. UN specialized agency)"
    },
    "predecessor": {
      "type": "string",
      "description": "Id of the entity this one succeeded"
    },
    "successor": {
      "type": "string",
      "description": "Id of the entity that succeeded this one"
    },
    "previous_names": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "period": { "type": "string" }
        },
        "additionalProperties": true
      },
      "description": "Former names with the period they were used"
    },
    "official_documents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["url"],
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "type": { "type": "string" }
        },
        "additionalProperties": true
      },
      "description": "Links to founding or official documents"
    },
    "social_media": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "description": "Social media handles keyed by platform"
    },
    "secretariat": {
      "type": "object",
      "properties": {
        "location": { "type": "string" },
        "organization": { "type": "string" }
      },
      "additionalProperties": true,
      "description": "Secretariat location and host organization"
    }
  }
}


