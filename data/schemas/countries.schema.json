{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Countries YAML schema",
  "type": "object",
  "additionalProperties": true,
  "required": ["code", "name", "iso3code", "numeric_code", "entity_type", "code_status"],
  "properties": {
    "code": {
      "type": "string",
      "minLength": 2,
      "maxLength": 2
    },
    "name": {
      "type": "string"
    },
    "iso3code": {
      "type": "string",
      "minLength": 3,
      "maxLength": 3
    },
    "numeric_code": {
      "type": "string",
      "pattern": "^\\d{3}$"
    },
    "capital_city": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "lat": { "type": ["string", "number"] },
        "lng": { "type": ["string", "number"] }
      },
      "additionalProperties": true
    },
    "region": {
      "type": "object",
      "required": ["id", "value"],
      "properties": {
        "id": { "type": "string" },
        "value": { "type": "string" }
      },
      "additionalProperties": true
    },
    "adminregion": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "value": { "type": "string" }
      },
      "additionalProperties": true
    },
    "incomeLevel": {
      "type": "object",
      "required": ["id", "value"],
      "properties": {
        "id": { "type": "string" },
        "value": { "type": "string" }
      },
      "additionalProperties": true
    },
    "lendingType": {
      "type": "object",
      "required": ["id", "value"],
      "properties": {
        "id": { "type": "string" },
        "value": { "type": "string" }
      },
      "additionalProperties": true
    },
    "wikidata_id": {
      "type": "string",
      "pattern": "^Q[1-9][0-9]*$"
    },
    "official_name": {
      "type": "string"
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "name"],
        "properties": {
          "code": { "type": "string" },
          "name": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "currencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "name"],
        "properties": {
          "code": { "type": "string" },
          "name": { "type": "string" },
          "symbol": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "un_member": {
      "type": "boolean"
    },
    "independent": {
      "type": "boolean"
    },
    "subregion": {
      "type": "string"
    },
    "continents": {
      "type": "array",
      "items": { "type": "string" }
    },
    "borders": {
      "type": "array",
      "description": "Land border neighbors as ISO 3166-1 alpha-3 codes (e.g. CAN, MEX)",
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{3}$"
      }
    },
    "population": {
      "type": ["object", "null"],
      "properties": {
        "value": { "type": "integer" },
        "year": { "type": "integer" },
        "source": { "type": "string" },
        "source_id": { "type": "string" }
      },
      "additionalProperties": true
    },
    "area": {
      "type": ["object", "null"],
      "properties": {
        "value": { "type": "number" },
        "year": { "type": "integer" },
        "source": { "type": "string" }
      },
      "additionalProperties": true
    },
    "gini": {
      "type": ["object", "null"],
      "properties": {
        "value": { "type": "number" },
        "year": { "type": "integer" },
        "source": { "type": "string" }
      },
      "additionalProperties": true
    },
    "native_names": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "official": { "type": "string" },
          "common": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "landlocked": {
      "type": "boolean"
    },
    "timezones": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "timezone_status": {
      "type": "string",
      "enum": ["not_applicable"]
    },
    "tld": {
      "type": "string"
    },
    "calling_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\+[0-9]+$"
      }
    },
    "flag_emoji": {
      "type": "string"
    },
    "car_side": {
      "type": "string",
      "enum": ["left", "right"]
    },
    "start_of_week": {
      "type": "string",
      "enum": ["monday", "saturday", "sunday"]
    },
    "demonyms": {
      "type": "object",
      "properties": {
        "female": { "type": "string" },
        "male": { "type": "string" }
      },
      "additionalProperties": true
    },
    "other_names": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "description": "Language code (e.g., 'ar', 'zh', 'en', 'fr', 'ru', 'es')" },
          "name": { "type": "string", "description": "Name in the specified language" }
        },
        "additionalProperties": true
      },
      "description": "Names in multiple languages (UN official languages)"
    },
    "common_names": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Common English names and alternative names for the country"
    },
    "m49_code": {
      "type": "string",
      "pattern": "^\\d{3}$",
      "description": "UN M49 numeric code (3-digit code for countries)"
    },
    "entity_type": {
      "type": "string",
      "enum": [
        "sovereign_state",
        "dependent_territory",
        "special_administrative_region",
        "disputed_territory",
        "historical_entity",
        "supranational_grouping",
        "statistical_area"
      ]
    },
    "code_status": {
      "type": "string",
      "enum": [
        "official_iso3166_1",
        "user_assigned",
        "obsolete",
        "exceptionally_reserved"
      ]
    },
    "recognition_status": {
      "type": "object",
      "properties": {
        "status": { "type": "string" },
        "un_member": { "type": "boolean" },
        "notes": { "type": "string" }
      },
      "additionalProperties": true
    },
    "parent_entity": {
      "type": "object",
      "properties": {
        "code": { "type": "string", "minLength": 2, "maxLength": 2 },
        "name": { "type": "string" }
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "source", "retrieved_at"],
        "properties": {
          "field": { "type": "string" },
          "source": { "type": "string" },
          "url": { "type": "string" },
          "retrieved_at": { "type": "string" },
          "license": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  }
}


