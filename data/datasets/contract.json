        }
      ],
      "description": "One row per country and language; countries without languages have no rows.",
      "definition": "SELECT c.code AS country_code, u.lang.code AS language_code, u.lang.name AS language_name, u.lang.official AS official FROM countries c, UNNEST(c.languages) AS u(lang) ORDER BY country_code, language_code"
    },
