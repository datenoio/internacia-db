      "description": "One row per country and language; countries without languages have no rows.",
      "definition": "SELECT c.code AS country_code, u.lang.code AS language_code, u.lang.name AS language_name, u.lang.official AS official FROM countries c, UNNEST(c.languages) AS u(lang) ORDER BY country_code, language_code"
    },
    {
      "name": "country_borders",
      "kind": "view",
      "in_duckdb": true,
      "primary_key": [
        "country_code",
        "neighbor_iso3"
      ],
      "foreign_keys": [],
      "schema_hash": "71ba6b977bc02e0486bb55fcd6a73aaf09ae7abd3ad3f6ffda2bc4d709f55957",
      "columns": [
        {
          "name": "country_code",
          "type": "string",
          "nullable": false
        },
        {
          "name": "iso3code",
          "type": "string",
          "nullable": true
        },
        {
          "name": "neighbor_iso3",
          "type": "string",
          "nullable": false
        },
        {
          "name": "current_status",
          "type": "string",
          "nullable": true
        }
      ],
      "description": "One row per country and land neighbour (countries.borders), with the pair's current border_status (closed or restricted), or NULL when no closure is recorded.",
      "definition": "SELECT b.country_code, b.iso3code, b.neighbor_iso3, s.status AS current_status FROM (SELECT c.code AS country_code, c.iso3code, UNNEST(c.borders) AS neighbor_iso3 FROM countries c) b LEFT JOIN border_status s ON s.\"until\" IS NULL AND ((s.country_a = b.iso3code AND s.country_b = b.neighbor_iso3) OR (s.country_b = b.iso3code AND s.country_a = b.neighbor_iso3)) ORDER BY country_code, neighbor_iso3"
    },
    {
      "name": "country_trade_agreements",
      "kind": "view",
      "in_duckdb": true,
      "primary_key": [
        "country_code",
        "agreement_id"
      ],
      "foreign_keys": [],
      "schema_hash": "7f013f291953a2b377cc33aad994b4d6ba205b90a808998feb87785e55e484f4",
      "columns": [
        {
          "name": "country_code",
          "type": "string",
          "nullable": false
        },
        {
          "name": "agreement_id",
          "type": "string",
          "nullable": false
        },
        {
          "name": "via",
          "type": "string",
          "nullable": true
        },
        {
          "name": "agreement_type",
          "type": "string",
          "nullable": true
        },
        {
          "name": "agreement_status",
          "type": "string",
          "nullable": true
        },
        {
          "name": "in_force",
          "type": "string",
          "nullable": true
        }
      ],
      "description": "One row per country and trade agreement it is a current party to. Country parties map directly (via NULL); a bloc party (the EU) is expanded to its current members from current_memberships, with via set to the bloc id. Coverage is current, not historical.",
      "definition": "WITH p AS (SELECT tp.party_id, tp.party_type, tp.agreement_id, tp.in_force AS party_in_force, a.agreement_type, a.status AS agreement_status, a.in_force AS agreement_in_force FROM trade_agreement_parties tp JOIN trade_agreements a ON a.id = tp.agreement_id WHERE tp.status = 'party'), r AS (SELECT party_id AS country_code, agreement_id, CAST(NULL AS VARCHAR) AS via, agreement_type, agreement_status, coalesce(party_in_force, agreement_in_force) AS in_force FROM p WHERE party_type IN ('country', 'territory') UNION ALL SELECT m.country_code, p.agreement_id, p.party_id AS via, p.agreement_type, p.agreement_status, p.agreement_in_force AS in_force FROM p JOIN current_memberships m ON m.intblock_id = p.party_id WHERE p.party_type = 'intblock' AND m.include_type IN ('country', 'territory') AND m.status IN ('member', 'founding_member', 'participant', 'associate', 'associate_member', 'associated')) SELECT country_code, agreement_id, via, agreement_type, agreement_status, in_force FROM r QUALIFY row_number() OVER (PARTITION BY country_code, agreement_id ORDER BY via NULLS FIRST) = 1 ORDER BY country_code, agreement_id"
    },
