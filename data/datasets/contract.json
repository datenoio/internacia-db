        },
        {
          "name": "country_code",
          "type": "string",
          "nullable": false
        },
        {
          "name": "include_type",
          "type": "string",
          "nullable": true
        },
        {
          "name": "status",
          "type": "string",
          "nullable": true
        },
        {
          "name": "joined",
          "type": "string",
          "nullable": true
        },
        {
          "name": "left",
          "type": "string",
          "nullable": true
        }
      ],
      "description": "Membership edges that are current: not former_member, no left date, and the intblock is neither historical nor dissolved. Every participation status is kept.",
      "definition": "SELECT m.* FROM memberships m JOIN intblocks i ON i.id = m.intblock_id WHERE m.status IS DISTINCT FROM 'former_member' AND m.\"left\" IS NULL AND i.status IS DISTINCT FROM 'historical' AND i.dissolved IS NULL ORDER BY m.intblock_id, m.country_code"
    },
    {
      "name": "country_currencies",
      "kind": "view",
      "in_duckdb": true,
      "primary_key": [
        "country_code",
        "currency_code"
      ],
      "foreign_keys": [],
      "schema_hash": "474b8fb6655122927cc2262ff67c135853076c431f9efc44760e45ff09317333",
      "columns": [
        {
          "name": "country_code",
          "type": "string",
          "nullable": false
        },
        {
          "name": "currency_code",
          "type": "string",
          "nullable": false
        },
        {
          "name": "currency_name",
          "type": "string",
          "nullable": true
        },
        {
          "name": "currency_symbol",
          "type": "string",
          "nullable": true
        }
      ],
      "description": "One row per country and currency; countries without currencies have no rows.",
      "definition": "SELECT c.code AS country_code, u.cur.code AS currency_code, u.cur.name AS currency_name, u.cur.symbol AS currency_symbol FROM countries c, UNNEST(c.currencies) AS u(cur) ORDER BY country_code, currency_code"
    },
    {
