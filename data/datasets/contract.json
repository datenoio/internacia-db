        "country_code"
      ],
      "foreign_keys": [],
      "schema_hash": "1bdbd0d9427722d3ed3c23ee0a101ccc0e62c8eba9e65ae0000f441648b0d76c",
      "columns": [
        {
          "name": "intblock_id",
          "type": "string",
